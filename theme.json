{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "color": {
      "custom": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "primary",
          "name": "Primary",
          "color": "var(--aznet-theme-color-primary)"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "var(--aznet-theme-color-surface)"
        },
        {
          "slug": "text",
          "name": "Text",
          "color": "var(--aznet-theme-color-text)"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "var(--aznet-theme-color-text-muted)"
        },
        {
          "slug": "success",
          "name": "Success",
          "color": "var(--aznet-theme-color-success)"
        },
        {
          "slug": "warning",
          "name": "Warning",
          "color": "var(--aznet-theme-color-warning)"
        },
        {
          "slug": "danger",
          "name": "Danger",
          "color": "var(--aznet-theme-color-danger)"
        }
      ]
    },
    "layout": {
      "contentSize": "var(--aznet-theme-container-content)",
      "wideSize": "var(--aznet-theme-container-wide)"
    },
    "spacing": {
      "spacingSizes": [
        {
          "slug": "1",
          "name": "1",
          "size": "var(--aznet-theme-space-1)"
        },
        {
          "slug": "2",
          "name": "2",
          "size": "var(--aznet-theme-space-2)"
        },
        {
          "slug": "3",
          "name": "3",
          "size": "var(--aznet-theme-space-3)"
        },
        {
          "slug": "4",
          "name": "4",
          "size": "var(--aznet-theme-space-4)"
        },
        {
          "slug": "6",
          "name": "6",
          "size": "var(--aznet-theme-space-6)"
        },
        {
          "slug": "section",
          "name": "Section",
          "size": "var(--aznet-theme-space-section)"
        }
      ],
      "units": [
        "px",
        "rem",
        "%"
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fontSizes": [
        {
          "slug": "sm",
          "name": "Small",
          "size": "var(--aznet-theme-font-size-sm)"
        },
        {
          "slug": "base",
          "name": "Base",
          "size": "var(--aznet-theme-font-size-base)"
        },
        {
          "slug": "lg",
          "name": "Large",
          "size": "var(--aznet-theme-font-size-lg)"
        },
        {
          "slug": "xl",
          "name": "Extra Large",
          "size": "var(--aznet-theme-font-size-xl)"
        }
      ],
      "fontFamilies": [
        {
          "slug": "roboto",
          "name": "Roboto",
          "fontFamily": "Roboto, Arial, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Roboto",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD",
              "src": [
                "file:./assets/fonts/roboto/Roboto-Regular.woff2"
              ]
            },
            {
              "fontFamily": "Roboto",
              "fontStyle": "normal",
              "fontWeight": "400",
              "fontDisplay": "swap",
              "unicodeRange": "U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB",
              "src": [
                "file:./assets/fonts/roboto/Roboto-Regular-Vietnamese.woff2"
              ]
            },
            {
              "fontFamily": "Roboto",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD",
              "src": [
                "file:./assets/fonts/roboto/Roboto-Medium.woff2"
              ]
            },
            {
              "fontFamily": "Roboto",
              "fontStyle": "normal",
              "fontWeight": "500",
              "fontDisplay": "swap",
              "unicodeRange": "U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB",
              "src": [
                "file:./assets/fonts/roboto/Roboto-Medium-Vietnamese.woff2"
              ]
            },
            {
              "fontFamily": "Roboto",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "unicodeRange": "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD",
              "src": [
                "file:./assets/fonts/roboto/Roboto-Bold.woff2"
              ]
            },
            {
              "fontFamily": "Roboto",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "unicodeRange": "U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB",
              "src": [
                "file:./assets/fonts/roboto/Roboto-Bold-Vietnamese.woff2"
              ]
            }
          ]
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--aznet-theme-color-surface)",
      "text": "var(--aznet-theme-color-text)"
    },
    "spacing": {
      "blockGap": "var(--aznet-theme-space-4)"
    },
    "typography": {
      "fontSize": "var(--aznet-theme-font-size-base)",
      "lineHeight": "var(--aznet-theme-line-height-body)",
      "fontFamily": "var:preset|font-family|roboto"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontSize": "var(--aznet-theme-text-h1)",
          "lineHeight": "var(--aznet-theme-line-height-h1)",
          "fontWeight": "var(--aznet-theme-font-weight-bold)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--aznet-theme-text-h2)",
          "lineHeight": "var(--aznet-theme-line-height-h2)",
          "fontWeight": "var(--aznet-theme-font-weight-bold)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--aznet-theme-text-h3)",
          "lineHeight": "var(--aznet-theme-line-height-h3)",
          "fontWeight": "var(--aznet-theme-font-weight-semibold)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--aznet-theme-text-h4)",
          "lineHeight": "var(--aznet-theme-line-height-h4)",
          "fontWeight": "var(--aznet-theme-font-weight-semibold)"
        }
      }
    }
  }
}
